# MongoDB Connection
# Local: mongodb://localhost:27017/grievance_db
# Production (Atlas): mongodb+srv://<username>:<password>@<cluster>.mongodb.net/grievance_db
# MONGO_URI=mongodb://localhost:27017/grievance_db
MONGO_URI=mongodb://localhost:27017/grievance_db
# JWT Secret
JWT_SECRET=your_jwt_secret_key_here

# Server Configuration
# ====================
PORT=3000

# Host configuration for mobile device support
# 0.0.0.0 allows connections from any network interface (required for mobile)
# 127.0.0.1 only allows localhost connections (laptop only)
HOST=0.0.0.0

# Email Configuration (Gmail SMTP - Free)
# Generate App Password at: https://myaccount.google.com/apppasswords
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_app_password
EMAIL_FROM=SmartCity GRS <your_email@gmail.com>

# Resend API (complaint tracking emails + OTP delivery - HTTP-based, no SMTP ports)
# REQUIRED for complaint tracking ID emails and Email OTP on cloud platforms (Render, etc.)
# Get your API key at: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key

# Frontend URL (used for invitation links)
# Local: http://localhost:8080
# Production: https://your-vercel-app.vercel.app
FRONTEND_URL=http://localhost:8080

# Roboflow API (for image validation)
ROBOFLOW_API_KEY=your_roboflow_api_key

# Node Environment
NODE_ENV=development
